<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SuperSudoku.MainPage">

    <VerticalStackLayout>
        <Button x:Name="ButtonSettings" Text="Settings" Margin="5,5,5,5" MaximumWidthRequest="150" Clicked="ButtonSettings_Clicked" />
        <Button x:Name="ButtonPlay" Text="Play!" Margin="5,5,5,5" MaximumWidthRequest="150" Clicked="ButtonPlay_Clicked" />
		<FlexLayout Direction="Column"
					AlignItems="Center"
					JustifyContent="SpaceEvenly">
            <Label Text="Background: Charcoal" BackgroundColor="#1C2518" />
            <Label Text="Surface" BackgroundColor="#45693B" />
            <Label Text="Primary Accent" BackgroundColor="#3C782B" />
            <Label Text="Secondary Accent" BackgroundColor="#7FC96B" />
                <Label Text="Highlight" BackgroundColor="#D2ECCB" TextColor="#1C2518" />
                <Label Text="Text Primary: Warm White" BackgroundColor="#FCFCF5" TextColor="#1C2518" />
                <Label Text="Text Secondary: Stone Grey" BackgroundColor="#E2E2DC" />
                <Label Text="Error/Conflict: Muted Terracotta" BackgroundColor="#BB6644" />
		</FlexLayout>
    </VerticalStackLayout>

</ContentPage>
