<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SuperSudoku.Views.SettingsView"
             Title="SettingsView">
    <VerticalStackLayout>
        <Label Text="Select Difficulty" FontSize="18" />
        <Picker x:Name="PickerDifficulty"
                Title="Difficulty"
                SelectedIndexChanged="PickerDifficulty_SelectedIndexChanged">
            <Picker.Items>
                <x:String>Easy</x:String>
                <x:String>Medium</x:String>
                <x:String>Hard</x:String>
            </Picker.Items>
        </Picker>
    </VerticalStackLayout>
</ContentPage>