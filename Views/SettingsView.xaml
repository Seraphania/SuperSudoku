<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SuperSudoku.Views.SettingsView"
             Title="SettingsView">
    <VerticalStackLayout>
        <Grid ColumnDefinitions="*, Auto"
              RowDefinitions="*,*">
            <Label Text="Show Timer" 
                   Grid.Column="0" 
                   Grid.Row="0"/>
            <Switch x:Name="SwitchShowTimer" 
                    Grid.Column="1"
                    Grid.Row="0"
                    Toggled="SwitchShowTimer_Toggled" />
            
            <Label Text="Toggle Dark Mode" 
                   Grid.Column="0"
                   Grid.Row="1"/>
            <Switch x:Name="SwitchDarkMode" 
                    Grid.Column="1"
                    Grid.Row="1"
                    Toggled="SwitchDarkMode_Toggled" />

        </Grid>
        <Label Text="Select Difficulty" FontSize="18" />
		<Picker x:Name="PickerDifficulty"
                Title="Difficulty"
                SelectedIndexChanged="PickerDifficulty_SelectedIndexChanged" />
	</VerticalStackLayout>
</ContentPage>