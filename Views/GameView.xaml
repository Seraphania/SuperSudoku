<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            
             x:Class="SuperSudoku.Views.GameView"
             Title="GameView">

    <VerticalStackLayout>
        <VerticalStackLayout.GestureRecognizers>
            <SwipeGestureRecognizer Direction="Right" 
                                    Swiped="SwipeGestureRecognizer_SwipedRight" />
        </VerticalStackLayout.GestureRecognizers>
        
        <Border Padding="0,0,0,0" Margin="0,0,0,0" Stroke="Black" StrokeThickness="3">
            <Grid x:Name="GridSudokuBoard" Margin="0" Padding="0" />
        </Border>
        
        
    </VerticalStackLayout>
</ContentPage>